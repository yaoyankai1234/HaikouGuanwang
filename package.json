{
  "name": "water-supply-pms",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "沿海村落供水管网延伸工程项目管理系统（自建后端 + 手机号密码登录）",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "serve": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-3000}"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
